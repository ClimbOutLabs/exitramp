index 0000000..87bf96f
--- /dev/null
+++ b/packages/frontend/src/toolPresentation.ts
@@ -0,0 +1,131 @@
+import type { ToolCallDisplayTone } from '@truefoundry/trueforge-ui';
+
+type JsonScalar = string | number | boolean | null;
+
+export type ResultDisplayTone = ToolCallDisplayTone | 'neutral';
+
+export type ReviewField = {
+  label: string;
+  value: string;
+  wide: boolean;
+};
+
+export type ToolPresentation =
+  | {
+      kind: 'approval-review';
+      reviewLabel: string;
+      heading: string;
+      headingLabel?: string;
+      fields: ReviewField[];
+    }
+  | {
+      kind: 'display-markdown';
+      markdown: string;
+      tone: ResultDisplayTone;
+    };
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === 'object' && value != null && !Array.isArray(value);
+}
+
+function isJsonScalar(value: unknown): value is JsonScalar {
+  return value == null || typeof value === 'string' || typeof value === 'number' || typeof value === 'boolean';
+}
+
+function humanizeKey(key: string): string {
+  const words = key
+    .replace(/([a-z0-9])([A-Z])/g, '$1 $2')
+    .replace(/[_-]+/g, ' ')
+    .trim();
+  if (!words) return key;
+  return `${words[0]?.toUpperCase() ?? ''}${words.slice(1)}`;
+}
+
+function scalarText(value: JsonScalar): string {
+  if (value === null) return 'null';
+  return String(value);
+}
+
+function isTechnicalField(label: string): boolean {
+  return /(^|\s)(approval (record|id)|evidence|technical|digest|hash)(\s|$)/i.test(label);
+}
+
+function isWideField({ label, value }: { label: string; value: string }): boolean {
+  return (
+    value.length >= 64 ||
+    /(^|\s)(constraints?|policy|limitations?|boundar(y|ies)|checks? completed|test plan|output)(\s|$)/i.test(label)
+  );
+}
+
+function parseApprovalReview(content: string): Extract<ToolPresentation, { kind: 'approval-review' }> | undefined {
+  let parsed: unknown;
+  try {
+    parsed = JSON.parse(content);
+  } catch {
+    return undefined;
+  }
+
+  if (!isRecord(parsed)) return undefined;
+  const rootEntries = Object.entries(parsed);
+  if (rootEntries.length !== 1) return undefined;
+
+  const rootEntry = rootEntries[0];
+  if (!rootEntry) return undefined;
+  const [rootKey, nestedValue] = rootEntry;
+  const reviewLabel = humanizeKey(rootKey);
+  if (!/(^|\s)(approval|review|confirmation)(\s|$)/i.test(reviewLabel) || !isRecord(nestedValue)) {
+    return undefined;
+  }
+
+  const nestedEntries = Object.entries(nestedValue);
+  if (nestedEntries.length < 2 || nestedEntries.length > 32) return undefined;
+  const scalarEntries: Array<[string, JsonScalar]> = [];
+  for (const [key, value] of nestedEntries) {
+    if (!isJsonScalar(value)) return undefined;
+    scalarEntries.push([key, value]);
+  }
+
+  const headingEntry = scalarEntries.find(
+    ([key, value]) =>
+      /^(decision|action|summary|title)$/i.test(key) && typeof value === 'string' && value.trim() !== '',
+  );
+  const headingKey = headingEntry?.[0];
+  const headingValue = headingEntry?.[1];
+  const fields = scalarEntries
+    .filter(([key]) => key !== headingKey)
+    .map(([key, value]) => ({ label: humanizeKey(key), value: scalarText(value) }))
+    .filter(field => !isTechnicalField(field.label))
+    .map(field => ({ ...field, wide: isWideField(field) }));
+
+  return {
+    kind: 'approval-review',
+    reviewLabel,
+    heading: typeof headingValue === 'string' ? headingValue : 'Review the exact request before continuing',
+    ...(headingKey ? { headingLabel: humanizeKey(headingKey) } : {}),
+    fields,
+  };
+}
+
+export function getToolPresentation({
+  title,
+  content,
+  isJson,
+  displayMarkdown,
+  displayTone,
+}: {
+  title: string;
+  content: string;
+  isJson: boolean;
+  displayMarkdown?: string;
+  displayTone?: unknown;
+}): ToolPresentation | undefined {
+  if (displayMarkdown?.trim()) {
+    return {
+      kind: 'display-markdown',
+      markdown: displayMarkdown,
+      tone: displayTone === 'positive' || displayTone === 'negative' ? displayTone : 'neutral',
+    };
+  }
+  if (title !== 'Request' || !isJson) return undefined;
+  return parseApprovalReview(content);
+}
diff --git a/packages/frontend/tests/toolPresentation.test.ts b/packages/frontend/tests/toolPresentation.test.ts
