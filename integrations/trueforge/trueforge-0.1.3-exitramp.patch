+++ b/packages/frontend/tests/toolPresentation.test.ts
@@ -0,0 +1,168 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+import { createElement } from 'react';
+import { renderToStaticMarkup } from 'react-dom/server';
+import { HumanReadableToolCallContent } from '../src/HumanReadableToolCallContent';
+import { getToolPresentation } from '../src/toolPresentation';
+
+describe('getToolPresentation', () => {
+  it('turns a generic nested approval object into labeled review facts', () => {
+    const presentation = getToolPresentation({
+      title: 'Request',
+      isJson: true,
+      content: JSON.stringify({
+        approval_request: {
+          Decision: 'Start the bounded comparison',
+          Models: 'Baseline A and candidate B',
+          'Request cap': 60,
+          Confirmed: false,
+          Constraints: 'Writes evaluation evidence only; performs no migration or deployment mutation.',
+          'Approval record': 'sha256:abc123',
+        },
+      }),
+    });
+
+    assert.deepEqual(presentation, {
+      kind: 'approval-review',
+      reviewLabel: 'Approval request',
+      heading: 'Start the bounded comparison',
+      headingLabel: 'Decision',
+      fields: [
+        { label: 'Models', value: 'Baseline A and candidate B', wide: false },
+        { label: 'Request cap', value: '60', wide: false },
+        { label: 'Confirmed', value: 'false', wide: false },
+        {
+          label: 'Constraints',
+          value: 'Writes evaluation evidence only; performs no migration or deployment mutation.',
+          wide: true,
+        },
+      ],
+    });
+  });
+
+  it('does not reinterpret unrelated or non-scalar request objects', () => {
+    const unrelated = getToolPresentation({
+      title: 'Request',
+      isJson: true,
+      content: JSON.stringify({ config: { mode: 'safe', retries: 2 } }),
+    });
+    const nested = getToolPresentation({
+      title: 'Request',
+      isJson: true,
+      content: JSON.stringify({ approval_request: { Decision: 'Run', targets: ['a', 'b'] } }),
+    });
+
+    assert.equal(unrelated, undefined);
+    assert.equal(nested, undefined);
+  });
+
+  it('uses display markdown only when it is non-empty', () => {
+    assert.deepEqual(
+      getToolPresentation({
+        title: 'Response',
+        isJson: true,
+        content: '{"status":"complete","display_markdown":"## Passed"}',
+        displayMarkdown: '## Passed',
+      }),
+      { kind: 'display-markdown', markdown: '## Passed', tone: 'neutral' },
+    );
+    assert.equal(
+      getToolPresentation({
+        title: 'Response',
+        isJson: true,
+        content: '{"display_markdown":"   "}',
+        displayMarkdown: '   ',
+      }),
+      undefined,
+    );
+  });
+
+  it('uses only an explicit display tone for accepted and rejected result surfaces', () => {
+    assert.deepEqual(
+      getToolPresentation({
+        title: 'Response',
+        isJson: true,
+        content: '{"status":"completed"}',
+        displayMarkdown: '## Migration evaluation: Eligible for migration',
+        displayTone: 'positive',
+      }),
+      {
+        kind: 'display-markdown',
+        markdown: '## Migration evaluation: Eligible for migration',
+        tone: 'positive',
+      },
+    );
+    assert.deepEqual(
+      getToolPresentation({
+        title: 'Response',
+        isJson: true,
+        content: '{"status":"completed"}',
+        displayMarkdown: '## Migration evaluation: Rejected for migration',
+        displayTone: 'negative',
+      }),
+      {
+        kind: 'display-markdown',
+        markdown: '## Migration evaluation: Rejected for migration',
+        tone: 'negative',
+      },
+    );
+  });
+
+  it('keeps title-derived and invalid display tones neutral', () => {
+    assert.deepEqual(
+      getToolPresentation({
+        title: 'Response',
+        isJson: true,
+        content: '{"status":"completed"}',
+        displayMarkdown: '## Migration evaluation: Rejected for migration',
+      }),
+      {
+        kind: 'display-markdown',
+        markdown: '## Migration evaluation: Rejected for migration',
+        tone: 'neutral',
+      },
+    );
+    assert.deepEqual(
+      getToolPresentation({
+        title: 'Response',
+        isJson: true,
+        content: '{"status":"completed"}',
+        displayMarkdown: '## Migration evaluation',
+        displayTone: 'warning',
+      }),
+      {
+        kind: 'display-markdown',
+        markdown: '## Migration evaluation',
+        tone: 'neutral',
+      },
+    );
+  });
+
+  it('labels neutral markdown as a review and toned markdown as a test result', () => {
+    const neutralMarkup = renderToStaticMarkup(
+      createElement(HumanReadableToolCallContent, {
+        title: 'Prepare migration evaluation approval',
