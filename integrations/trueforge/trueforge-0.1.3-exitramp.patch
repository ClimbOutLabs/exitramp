@@ -0,0 +1,111 @@
+import { Markdown, ToolCallContentBlock, type ToolCallContentBlockProps } from '@truefoundry/trueforge-ui';
+import { useState } from 'react';
+import { getToolPresentation } from './toolPresentation';
+
+function TechnicalDetails({
+  content,
+  copyValue,
+  dataTestPrefix,
+}: {
+  content: string;
+  copyValue: string;
+  dataTestPrefix?: string;
+}) {
+  const [copied, setCopied] = useState(false);
+
+  const copyExactPayload = () => {
+    void navigator.clipboard.writeText(copyValue).then(() => {
+      setCopied(true);
+      setTimeout(() => setCopied(false), 1500);
+    });
+  };
+
+  return (
+    <details className="human-tool-card__details">
+      <summary>Technical details</summary>
+      <div className="human-tool-card__payload-actions">
+        <span>Exact JSON sent with this tool call</span>
+        <button type="button" onClick={copyExactPayload}>
+          {copied ? 'Copied' : 'Copy JSON'}
+        </button>
+      </div>
+      <pre data-testid={dataTestPrefix ? `${dataTestPrefix}-exact-json` : undefined}>{content}</pre>
+    </details>
+  );
+}
+
+export function HumanReadableToolCallContent(props: ToolCallContentBlockProps) {
+  const presentation = getToolPresentation({
+    title: props.title,
+    content: props.content,
+    isJson: props.isJson !== false,
+    ...(props.displayMarkdown ? { displayMarkdown: props.displayMarkdown } : {}),
+    ...(props.displayTone ? { displayTone: props.displayTone } : {}),
+  });
+
+  if (!presentation) return <ToolCallContentBlock {...props} />;
+
+  const dataTestId = props.dataTestPrefix ? `${props.dataTestPrefix}-content-block` : 'tfy-tool-call-content-block';
+  const className = ['human-tool-card', props.className].filter(Boolean).join(' ');
+  const exactPayload = props.copyValue ?? props.content;
+
+  if (presentation.kind === 'display-markdown') {
+    const isTestResult = presentation.tone !== 'neutral';
+    const ariaLabel = isTestResult ? 'Pre-migration test result' : 'Pre-migration review';
+    const statusLabel = isTestResult ? 'Pre-migration Test Result' : 'Pre-migration Review';
+
+    return (
+      <section
+        aria-label={ariaLabel}
+        className={`${className} human-tool-card--result human-tool-card--result-${presentation.tone}`}
+        data-content={props.content}
+        data-display-tone={presentation.tone}
+        data-testid={dataTestId}
+      >
+        <header className="human-tool-card__masthead">
+          <span>{props.title}</span>
+          <span className="human-tool-card__status">{statusLabel}</span>
+        </header>
+        <div className="human-tool-card__markdown">
+          <Markdown content={presentation.markdown} readOnly />
+        </div>
+        <TechnicalDetails
+          content={props.content}
+          copyValue={exactPayload}
+          {...(props.dataTestPrefix ? { dataTestPrefix: props.dataTestPrefix } : {})}
+        />
+      </section>
+    );
+  }
+
+  return (
+    <section
+      aria-label="Approval request details"
+      className={`${className} human-tool-card--approval`}
+      data-content={props.content}
+      data-testid={dataTestId}
+    >
+      <header className="human-tool-card__masthead">
+        <span>{presentation.reviewLabel}</span>
+        <span className="human-tool-card__status">Review required</span>
+      </header>
+      <div className="human-tool-card__decision">
+        <span>{presentation.headingLabel ?? 'Requested action'}</span>
+        <h3>{presentation.heading}</h3>
+      </div>
+      <dl className="human-tool-card__facts">
+        {presentation.fields.map(field => (
+          <div className={field.wide ? 'human-tool-card__fact--wide' : undefined} key={field.label}>
+            <dt>{field.label}</dt>
+            <dd>{field.value}</dd>
+          </div>
+        ))}
+      </dl>
+      <TechnicalDetails
+        content={props.content}
+        copyValue={exactPayload}
+        {...(props.dataTestPrefix ? { dataTestPrefix: props.dataTestPrefix } : {})}
+      />
+    </section>
+  );
+}
